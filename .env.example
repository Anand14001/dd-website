# ---------------------------------------------------------------------------
# Digital Dude — environment variables
# Copy to .env for local development. In production set these in
# Vercel → Project Settings → Environment Variables, then redeploy.
# ---------------------------------------------------------------------------

# Gemini API key (required for AI chat answers).
# Without it the assistant still replies, but only with canned fallback text —
# the admin dashboard's Bot health tab will show a 100% fallback rate.
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-3.8-flash if omitted)
# GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Lead database (Neon Postgres)
# Create a free database at neon.tech, or add Neon from the Vercel Marketplace,
# then paste the pooled connection string here. Required for lead capture and
# the admin dashboard. Without it the site still works, but nothing is stored.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin)
# ADMIN_PASSWORD is compared server-side only and never sent to the browser.
# There is no fallback default: if it is unset, login returns a configuration
# error rather than accepting a password committed to the repository.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=Admin@123

# Optional. Signs the session cookie. If unset, a key is derived from
# ADMIN_PASSWORD, which is already secret — set it explicitly if you want
# sessions to survive a password change.
# ADMIN_SESSION_SECRET=

# Optional. Session lifetime in hours (default 8).
# ADMIN_SESSION_HOURS=8

# ---------------------------------------------------------------------------
# WhatsApp lead alerts (Meta WhatsApp Cloud API)
# Entirely optional — leads are captured either way. See WHATSAPP_SETUP.md.
# ---------------------------------------------------------------------------

# From Meta → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Who gets alerted, comma separated, with country code and no symbols.
# Example: 919787097006,918939651525
WHATSAPP_ALERT_TO=

# Optional: the approved template to send (default new_lead_alert).
# WHATSAPP_TEMPLATE_NAME=new_lead_alert
# WHATSAPP_TEMPLATE_LANG=en

# Optional: alert threshold — hot | warm | cold (default warm).
# WHATSAPP_ALERT_MIN_TEMPERATURE=warm

# Optional: send plain text instead of a template. Only works inside the 24-hour
# customer service window, so leave this off for business-initiated alerts.
# WHATSAPP_USE_TEXT=false

# Optional: Graph API version (default v21.0).
# WHATSAPP_API_VERSION=v21.0
